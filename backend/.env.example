# Copy to `.env` for local development. Never commit real values.

# development | test | staging | production
# In production, DATABASE_URL and SUPABASE_URL are required (startup fails otherwise)
# and the OpenAPI docs are disabled unless ENABLE_DOCS=true.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port uvicorn binds to. The host injects it automatically (Render sets 10000).
PORT=8000

# Supabase Postgres via the Supavisor *session* pooler (IPv4, port 5432):
#   Dashboard -> Connect -> Session pooler.
# The transaction pooler (port 6543) also works: statement caching is disabled.
# A plain postgresql:// URL is fine; the driver is switched to asyncpg automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS mode for the DB connection: disable | allow | prefer | require | verify-ca | verify-full
# (an `sslmode=` query parameter on DATABASE_URL takes precedence). Use `require` for Supabase.
DATABASE_SSL=require

# Optional pool / timeout tuning (defaults shown; sized for a small free instance).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_S=10
# DB_POOL_RECYCLE_S=1800
# DB_STATEMENT_TIMEOUT_MS=15000

# Supabase project URL (no trailing slash). Used for the JWKS endpoint
# ({SUPABASE_URL}/auth/v1/.well-known/jwks.json) and to validate the token issuer.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional. Only needed if the project still issues legacy HS256 tokens
# (Dashboard -> Project Settings -> JWT Keys -> Legacy JWT secret).
SUPABASE_JWT_SECRET=

# Optional JWT tuning (defaults shown).
# JWT_LEEWAY_S=10
# JWKS_CACHE_LIFESPAN_S=600

# Comma-separated list of allowed browser origins. `*` is rejected.
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# Force OpenAPI docs on/off at /api/docs (default: on everywhere except production).
# ENABLE_DOCS=true

# Optimizer (OR-Tools CP-SAT). Defaults shown.
#   OPTIMIZER_TIME_LIMIT_S : wall-clock limit per solve (0-300). Explaining an infeasible
#                            model may take up to the same time again.
#   OPTIMIZER_WORKERS      : CP-SAT search threads per run (1-32). Keep below the vCPU count.
#   OPTIMIZER_STALE_AFTER_S: queued/running runs older than this are marked failed (server
#                            restarted mid-run). Must exceed 2 x OPTIMIZER_TIME_LIMIT_S.
# OPTIMIZER_TIME_LIMIT_S=20
# OPTIMIZER_WORKERS=4
# OPTIMIZER_STALE_AFTER_S=180

# AI intake (Claude extracts scope items, with evidence, from pasted notes and uploaded
# PDF / Word / transcript files). Without a key, intake runs use the deterministic
# rule-based extractor instead (headings + bullets; the run's model is "rules").
# Uploads need no configuration: max 50 MB per file, only the extracted text is stored.
# INTAKE_MODEL defaults to the same Sonnet model as AI_MODEL. Every successful Claude
# call (intake, project drafts, WBS generate/validate, step-7 change detection, the
# assistant) records its tokens in the ai_usage_events table.
ANTHROPIC_API_KEY=
# INTAKE_MODEL=claude-sonnet-5-5
# INTAKE_STALE_AFTER_S=180

# AI WBS generation/validation and the planning assistant (same ANTHROPIC_API_KEY).
# Without a key: WBS generation uses a deterministic template, validation runs only
# the deterministic checks, and the assistant answers 503.
#   AI_JOB_STALE_AFTER_S: queued/running AI jobs older than this are marked failed.
#   ASSISTANT_TIMEOUT_S : limit for one assistant reply (the API answers 503 after it).
# AI_MODEL=claude-sonnet-5-5
# AI_JOB_STALE_AFTER_S=600
# ASSISTANT_TIMEOUT_S=60

# Set automatically by Render; reported by GET /health as `version`.
# RENDER_GIT_COMMIT=
